{
  "name": "chrono-digger",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "index:corpus": "tsx scripts/index-corpus.ts",
    "index:check": "tsx scripts/index-corpus.ts --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "26.6.5",
    "@vitest/runner": "4.1.12",
    "@vitest/snapshot": "4.1.12",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.3"
  }
}
